<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sabrina e Rhuan</title>
    <link rel="stylesheet" href="style.css">
    <link rel="shortcut icon" href="images/S-R.png" type="image/x-icon">
</head>
<body>
    <div class="container">

        <header>
            <h1>Cadastro</h1>
        </header>

        <main>
            <div class="dadosIniciais">
                <form action="/cadastro" method="post">
                    <label for="nomeEsposa">Nome da noiva:</label>
                    <input type="text" name="nomeEsposa" id="nomeEsposa" placeholder="Apenas o primeiro nome..." required />
                    <label for="nomeMarido">Nome do noivo:</label>
                    <input type="text" name="nomeMarido" id="nomeMarido" placeholder="Apenas o primeiro nome..." required />
                    <label for="dataEvento">Data do evento:</label>
                    <input type="date" name="dataEvento" id="dataEvento" placeholder="Data do evento..." required />
                    <label for="usuario">Usuário:</label>
                    <input type="text" name="usuario" id="usuario" placeholder="Usuário..." required />
                    <label for="senha">Senha:</label>
                    <input type="password" name="senha" id="senha" placeholder="Senha..." required />
                    <button type="submit">Iniciar</button>
                </form>
            </div>

            <% if(mensagem.length > 0) { %>
                <p><%= mensagem %></p>
            <% } %>
        </main>

        <footer>

        </footer>
    </div>
    <script src="cadastro/cadastro.js"></script>
</body>
</html>